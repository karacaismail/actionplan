{
  "schemaVersion": "1.0.0",
  "source": "docs/standards-applicability-matrix.md",
  "authorityNote": "ADR-0026 teknoloji profilini Surface seviyesinde bağladığı için techProfileRef level default'u değildir; yalnız frontendUi overlay'inde zorunludur.",
  "canonicalRefValues": {
    "architectureRef": "architecture",
    "codingStandardRef": "coding-standards",
    "shortCodeRef": "short-code",
    "qualityGateRef": "quality-gates",
    "designSystemRef": "design-system",
    "uiComponentRef": "ui-components",
    "uxStandardRef": "ux-interaction",
    "dataApiContractRef": "data-api-contract",
    "stateContractRef": "state-management",
    "testingStandardRef": "testing-strategy",
    "observabilityRef": "observability",
    "releasePolicyRef": "release-versioning",
    "aiGovernanceRef": "ai-governance",
    "i18nRef": "i18n-standards"
  },
  "requiredByLevel": {
    "app": ["architectureRef", "releasePolicyRef", "aiGovernanceRef", "i18nRef"],
    "module": [
      "architectureRef",
      "qualityGateRef",
      "dataApiContractRef",
      "observabilityRef",
      "testingStandardRef",
      "releasePolicyRef",
      "aiGovernanceRef",
      "i18nRef"
    ],
    "archetype": [
      "architectureRef",
      "codingStandardRef",
      "shortCodeRef",
      "qualityGateRef",
      "dataApiContractRef",
      "observabilityRef",
      "testingStandardRef",
      "releasePolicyRef",
      "aiGovernanceRef",
      "i18nRef"
    ],
    "feature": [
      "codingStandardRef",
      "shortCodeRef",
      "qualityGateRef",
      "dataApiContractRef",
      "testingStandardRef"
    ],
    "component": ["codingStandardRef", "shortCodeRef", "testingStandardRef"],
    "work_unit": ["codingStandardRef", "shortCodeRef", "testingStandardRef"],
    "micro_step": []
  },
  "surfaceOverlays": {
    "frontendUi": {
      "uiArtifactRoles": ["produces-ui", "changes-ui-contract"],
      "requiredRefs": [
        "techProfileRef",
        "designSystemRef",
        "uiComponentRef",
        "uxStandardRef",
        "stateContractRef",
        "i18nRef"
      ]
    }
  },
  "semanticOverlays": [
    {
      "id": "app-market-readiness",
      "levels": ["app"],
      "match": ".*",
      "requiredRefs": { "globalMarketReadinessRef": "global-market-readiness" }
    },
    {
      "id": "ui-accessibility-globalization",
      "uiArtifactRoles": ["produces-ui", "changes-ui-contract"],
      "match": ".*",
      "requiredRefs": { "a11yRef": "a11y", "g11nRef": "g11n" }
    },
    {
      "id": "identity-access",
      "match": "identity|kimlik|iam|sso|oidc|mfa|authz|rbac|abac|permission|yetki|policy|pdp|user|kullanıcı|member|party|organization|tenant",
      "requiredRefs": {
        "ssoRef": "sso",
        "oidcRef": "oidc",
        "mfaRef": "mfa",
        "authzRef": "authz-rbac-abac",
        "identityDataRef": "identity-data"
      }
    },
    {
      "id": "canonical-normalized-data",
      "match": "canonical|kanonik|normaliz|dedup|de-dup|import|migration|migrate|eşleme|mapping",
      "requiredRefs": {
        "c13nRef": "c13n",
        "dataNormalizationRef": "data-normalization"
      }
    },
    {
      "id": "api-interoperability",
      "match": "api|graphql|rest|sdk|webhook|integration|entegrasyon|import|export|event|outbox",
      "requiredRefs": { "i14yRef": "i14y" }
    },
    {
      "id": "customization-personalization",
      "match": "custom|özelleştir|personal|kişiselleştir|tenant theme|tema|preference|tercih",
      "requiredRefs": { "c12nRef": "c12n", "p13nRef": "p13n" }
    },
    {
      "id": "edge-infrastructure",
      "match": "edge|gateway|waf|cors|rate.?limit|cdn|deploy|infra|swarm|k8s|kubernetes|container|docker|ci.?cd|observability",
      "requiredRefs": { "edgeSecurityRef": "edge-security", "iacRef": "iac" }
    },
    {
      "id": "finance-money",
      "match": "finance|finans|payment|ödeme|money|para|currency|kur|ledger|muhasebe|accounting|billing|fatura|invoice|tax|vergi|payroll|bordro|treasury",
      "requiredRefs": { "financeModelRef": "finance-money-model" }
    },
    {
      "id": "search-quality",
      "match": "search|arama|catalog|katalog|filter|filtre|rank|sıralama|discover|keşif",
      "requiredRefs": { "searchQualityRef": "search-quality" }
    },
    {
      "id": "decision-grade-data",
      "match": "bi\\b|dashboard|kpi|metric|metrik|report|rapor|analytics|analitik|forecast|tahmin|decision|karar",
      "requiredRefs": { "decisionGradeRef": "decision-grade-data" }
    },
    {
      "id": "global-market-context",
      "match": "global|market|pazar|locale|i18n|g11n|jurisdiction|ülke|currency|timezone|rtl|localization|yerelleştir",
      "requiredRefs": { "globalMarketReadinessRef": "global-market-readiness" }
    }
  ]
}
